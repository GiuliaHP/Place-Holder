  dialogueLines:
  - characterName: Lapin
    dialogueText: Salut Renard !
    characterSprite: {fileID: 0}
  - characterName: Lapin
    dialogueText: "Je crois que H\xE9ron \xE0 une lettre pour toi."
    characterSprite: {fileID: 0}
  - characterName: Lapin
    dialogueText: Tu devrais le trouver avant qu'il ne migre !
    characterSprite: {fileID: 0}
  - characterName: Lapin
    dialogueText: Bon je te laisse...
    characterSprite: {fileID: 0}
  - characterName: Lapin
    dialogueText: My people needs me.
    characterSprite: {fileID: 0}
